# ==============================================================================
# EASYLEAD AFRICA - VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier vers .env.local pour le développement local.
# En production sur Vercel, ajoutez ces variables dans Project Settings > Environment Variables.
# ==============================================================================

# URL de l'application (http://localhost:3000 en local, https://easylead.africa en prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. SUPABASE (Base de données PostgreSQL, Auth & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Requis côté serveur pour les RPC admin, webhook CinetPay & Apify
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SIGNUP_BONUS_CREDITS=50

# ------------------------------------------------------------------------------
# 2. SCRAPING GOOGLE PLACES (Apify Actor compass/crawler-google-places)
# ------------------------------------------------------------------------------
APIFY_TOKEN=your-apify-token-here
APIFY_WEBHOOK_SECRET=your-apify-webhook-secret-here

# ------------------------------------------------------------------------------
# 3. MOTEUR D'INTELLIGENCE ARTIFICIELLE (WhatsApp, Email & Script d'appel)
# Choisissez au choix : OpenAI (ex: gpt-4o) OU Anthropic Claude (direct ou via Vercel AI Gateway)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
# Ou si vous utilisez Anthropic Claude :
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AI_MODEL=gpt-4o


# ------------------------------------------------------------------------------
# 4. PASSERELLE DE PAIEMENT MOBILE MONEY (CinetPay - Cameroun & CEMAC)
# Note : En local sans clés réelles, le mode Sandbox s'active automatiquement.
# ------------------------------------------------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Définir à true pour forcer les appels réseau CinetPay réels même en dev
# CINETPAY_FORCE_LIVE=true

# Numéros de test & support officiel Douala, Cameroun :
# MTN MoMo : +237 677 48 11 61
# Orange Money : +237 691 11 49 08
